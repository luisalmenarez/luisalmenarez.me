---
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Layout from '@/layouts/Layout.astro';
import ArrowRight from '@/components/icons/ArrowRight.astro';
import {
  PROJECTS,
  ROLE_LABEL,
  STATUS_LABEL,
  buildProjectSchema,
} from '@/data/projects';
import { PROFILE } from '@/data/profile';
import { defaultLocale, getLocalizedPath, locales, useTranslations } from '@/i18n';

/**
 * The route segment stays `proyectos` in both locales on purpose.
 * `getLocalizedPath()` derives the sibling URL by stripping and re-adding the
 * locale prefix; a segment that changed per locale would break it and point
 * hreflang at URLs that do not exist. Translating the segment needs a per-locale
 * route map, which is its own change.
 */
export const getStaticPaths = (() => {
  return locales.flatMap((locale) =>
    PROJECTS.map((project) => ({
      params: {
        lang: locale === defaultLocale ? undefined : locale,
        slug: project.slug,
      },
      props: { project, locale },
    }))
  );
}) satisfies GetStaticPaths;

// `Astro.props` is inferred from what getStaticPaths returns above.
const { project, locale: lang } = Astro.props;
const t = useTranslations(lang);

const title = project.title[lang];
const description = project.description[lang];
const highlights = project.highlights[lang];
const flow = project.flow?.[lang];
const caseStudy = project.caseStudy?.[lang];
const statusKey =
  project.status in STATUS_LABEL
    ? (project.status as keyof typeof STATUS_LABEL)
    : null;
const companyDescription = project.company?.description?.[lang];

// Consecutive phone shots share a row; every desktop shot takes the full measure.
type GalleryRow = { device: 'desktop' | 'phone'; shots: NonNullable<typeof project.gallery> };
const galleryRows = (project.gallery ?? []).reduce<GalleryRow[]>((rows, shot) => {
  const last = rows.at(-1);
  if (shot.device === 'phone' && last?.device === 'phone') last.shots.push(shot);
  else rows.push({ device: shot.device, shots: [shot] });
  return rows;
}, []);

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const schema = buildProjectSchema({ project, lang, url: canonical });

// The project shot stays the share card here: it says more about this page than
// the generic branded card does. Its URL carries a content hash, so editing a
// screenshot mints a new URL — which is the harmless direction, since fresh
// shares pick up the new image and already-shared links keep the shot that was
// accurate when they were posted.
const ogImage = project.image
  ? new URL(project.image.src, Astro.site).toString()
  : undefined;
const ogImageSize = project.image
  ? { width: project.image.width, height: project.image.height }
  : undefined;
---

<Layout
  title={`${title} · ${PROFILE.name}`}
  lang={lang}
  description={description}
  ogImage={ogImage}
  ogImageSize={ogImageSize}
  ogImageAlt={project.image ? title : undefined}
  schema={schema}
>
  <main class="page">
    <a class="back meta" href={`${getLocalizedPath('/', lang)}#${project.slug}`}>
      <ArrowRight class="flip" />
      {t('projects.backToList')}
    </a>

    <header class="head">
      <h1 class="serif title">{title}</h1>
      <p class="meta tags">
        <span>{project.period[lang]}</span>
        <span>{t(ROLE_LABEL[project.role])}</span>
        {statusKey && <span>{t(STATUS_LABEL[statusKey])}</span>}
        {project.proof && <span>{project.proof[lang]}</span>}
      </p>
      {
        project.company && (
          <p class="company">
            {project.company.url ? (
              <a class="draw" href={project.company.url} target="_blank" rel="noopener noreferrer">
                {project.company.name}
              </a>
            ) : (
              <span>{project.company.name}</span>
            )}
            {companyDescription && <span> · {companyDescription}</span>}
          </p>
        )
      }
    </header>

    <p class="serif lede">{description}</p>

    {
      project.image && (
        <Image
          src={project.image}
          alt={title}
          class="shot"
          loading="eager"
          fetchpriority="high"
          widths={[640, 1080, 1600]}
          sizes="(min-width: 1200px) 1100px, 100vw"
        />
      )
    }

    <div class="columns">
      <div class="main">
        {
          flow && (
            <section aria-labelledby="flow-heading">
              <h2 id="flow-heading" class="meta label">{t('projects.flow')}</h2>
              <ol class="flow serif">
                {flow.map((step) => <li>{step}</li>)}
              </ol>
            </section>
          )
        }
        {
          caseStudy ? (
            caseStudy.map((section) => (
              <section>
                <h2 class="serif h2">{section.heading}</h2>
                {section.body && <p class="prose">{section.body}</p>}
                {section.items && (
                  <ul class="items">
                    {section.items.map((item) => <li>{item}</li>)}
                  </ul>
                )}
              </section>
            ))
          ) : (
            <section>
              <h2 class="serif h2">{t('projects.features')}</h2>
              <ul class="items">
                {highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
            </section>
          )
        }
      </div>

      <aside class="side">
        <h2 class="meta label">{t('projects.technologies')}</h2>
        <ul class="tech serif">
          {project.tags.map((tag) => <li>{tag.name}</li>)}
        </ul>
        {
          (project.link || project.github) && (
            <div class="out">
              {project.link && (
                <a class="pill" href={project.link} target="_blank" rel="noopener noreferrer">
                  {t('projects.visitSite')}
                  <ArrowRight />
                </a>
              )}
              {project.github && (
                <a class="draw" href={project.github} target="_blank" rel="noopener noreferrer">
                  {t('projects.viewGithub')}
                </a>
              )}
            </div>
          )
        }
      </aside>
    </div>

    {
      galleryRows.length > 0 && (
        <section class="gallery" aria-labelledby="gallery-heading">
          <h2 id="gallery-heading" class="meta label">{t('projects.gallery')}</h2>
          {galleryRows.map((row) => (
            <div class:list={['row', row.device]}>
              {row.shots.map((shot) => (
                <figure data-reveal>
                  <Image
                    src={shot.image}
                    alt={shot.caption[lang]}
                    loading="lazy"
                    widths={row.device === 'phone' ? [400, 600, 900] : [800, 1280, 1800, 2400]}
                    sizes={
                      row.device === 'phone'
                        ? '(min-width: 900px) 340px, 45vw'
                        : '(min-width: 1280px) 1232px, 100vw'
                    }
                  />
                  <figcaption>{shot.caption[lang]}</figcaption>
                </figure>
              ))}
            </div>
          ))}
        </section>
      )
    }
  </main>
</Layout>

<style>
  .page {
    padding: 112px var(--gutter) 12vh;
    max-width: 1280px;
    margin: 0 auto;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-2);
    transition: color 0.3s;
  }
  .back:hover {
    color: var(--ink);
  }
  .back :global(.flip) {
    transform: rotate(180deg);
  }
  .head {
    margin-top: 8vh;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    color: var(--ink-2);
    margin: 26px 0 0;
  }
  .title {
    margin: 0;
    font-weight: 400;
    font-size: clamp(44px, 7vw, 112px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    max-width: 16ch;
    text-wrap: balance;
  }
  .company {
    margin: 22px 0 0;
    color: var(--ink-2);
  }
  .lede {
    margin: 8vh 0 0;
    font-size: clamp(22px, 2.2vw, 32px);
    line-height: 1.3;
    max-width: 38ch;
    text-wrap: pretty;
  }
  .shot {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 8vh;
    border-radius: 2px;
  }
  .columns {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 8vw;
    margin-top: 10vh;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
  }
  .main section + section {
    margin-top: 7vh;
  }
  .label {
    margin: 0 0 14px;
    color: var(--ink-3);
  }
  .h2 {
    margin: 0 0 18px;
    font-weight: 400;
    font-size: clamp(26px, 2.6vw, 38px);
    line-height: 1.1;
  }
  .prose {
    margin: 0;
    color: var(--ink-2);
    max-width: 64ch;
    text-wrap: pretty;
  }
  .items {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 64ch;
  }
  .items li {
    padding: 12px 0;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
    font-size: 22px;
  }
  .flow li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 40px 1fr;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
  }
  .flow li::before {
    content: counter(step, decimal-leading-zero);
    font-style: italic;
    font-size: 15px;
    color: var(--ink-3);
    padding-top: 5px;
  }
  .side {
    align-self: start;
    position: sticky;
    top: 96px;
  }
  .tech {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 22px;
    line-height: 1.45;
  }
  .out {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 22px;
  }
  .gallery {
    margin-top: 14vh;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
  }
  .gallery .row + .row {
    margin-top: 10vh;
  }
  .gallery figure {
    margin: 0;
  }
  .gallery img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: 2px;
  }
  .gallery .phone {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 340px));
    justify-content: center;
    gap: clamp(16px, 6vw, 96px);
  }
  .gallery .phone img {
    border-color: var(--rule-strong);
    border-radius: 28px;
  }
  .gallery figcaption {
    margin-top: 16px;
    max-width: 56ch;
    color: var(--ink-2);
    font-size: 15px;
    text-wrap: pretty;
  }
  @media (max-width: 900px) {
    .columns {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
    }
  }
</style>
