---
import Layout from '@/layouts/Layout.astro';
import ArrowRight from '@/components/icons/ArrowRight.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '@/i18n';
import type { GetStaticPaths } from 'astro';

/**
 * Built for both locales, mirroring the index route, so /404.html and
 * /en/404.html both exist.
 *
 * Vercel serves a single root 404.html for static output — it does not pick the
 * nearest one per directory — so today every miss lands on the Spanish page.
 * Generating both anyway keeps the English copy ready for a routing rule that
 * maps /en/* to /en/404.html, and costs one extra HTML file until then. The
 * alternative, swapping the copy client-side, would have left the header and
 * footer in Spanish around English body text.
 */
export const getStaticPaths = (() => {
  return [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
}) satisfies GetStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homeHref = getLocalizedPath('/', lang);
const projectsHref = `${homeHref}#archivo`;
---

<Layout title={t('notFound.title')} lang={lang} noindex>
  <main class="nf">
    <p class="meta code">404</p>
    <h1 class="serif heading">{t('notFound.heading')}</h1>
    <p class="body">{t('notFound.body')}</p>
    <div class="actions">
      <a class="pill" href={homeHref}>
        {t('notFound.home')}
        <ArrowRight />
      </a>
      <a class="draw" href={projectsHref}>{t('notFound.projects')}</a>
    </div>
  </main>
</Layout>

<style>
  .nf {
    min-height: 82svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 112px var(--gutter) 10vh;
  }
  .code {
    color: var(--volt);
    margin: 0 0 22px;
  }
  .heading {
    margin: 0;
    font-weight: 400;
    font-size: clamp(48px, 7vw, 112px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    max-width: 14ch;
  }
  .body {
    margin: 26px 0 0;
    color: var(--ink-2);
    max-width: 46ch;
  }
  .actions {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 24px;
  }
</style>
