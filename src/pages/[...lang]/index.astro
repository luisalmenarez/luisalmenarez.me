---
import Layout from '@/layouts/Layout.astro';
import ArchiveChapter from '@/components/ArchiveChapter.astro';
import CaseChapter from '@/components/CaseChapter.astro';
import Cover from '@/components/Cover.astro';
import type { IndexEntry } from '@/components/Cover.astro';
import HowChapter from '@/components/HowChapter.astro';
import PathChapter from '@/components/PathChapter.astro';
import { PROJECTS, SELECTED_WORK } from '@/data/projects';
import { getLangFromUrl, useTranslations } from '@/i18n';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
}) satisfies GetStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const cases = SELECTED_WORK.map((slug) => {
  const project = PROJECTS.find((p) => p.slug === slug);
  if (!project) throw new Error(`SELECTED_WORK lists an unknown project: ${slug}`);
  return project;
});

// The cover is page 01; every chapter after it gets the next folio, so the
// numbers in the index and the numbers on the chapters are the same sequence.
const folio = (n: number) => String(n + 2).padStart(2, '0');
const pages = {
  path: folio(cases.length),
  how: folio(cases.length + 1),
  archive: folio(cases.length + 2),
};

const entries: IndexEntry[] = [
  ...cases.map((project, i) => ({
    href: `#${project.slug}`,
    title: project.shortTitle?.[lang] ?? project.title[lang],
    dek: project.dek?.[lang],
    ghost: project.proof?.[lang] ?? project.title[lang],
    page: folio(i),
  })),
  { href: '#trayectoria', title: t('chapter.path'), ghost: t('chapter.path.ghost'), page: pages.path, minor: true },
  { href: '#como-trabajo', title: t('chapter.how'), ghost: t('chapter.how.ghost'), page: pages.how, minor: true },
  { href: '#archivo', title: t('chapter.archive'), ghost: t('chapter.archive.ghost'), page: pages.archive, minor: true },
];
---

<Layout title={t('meta.title')} lang={lang} withContact>
  <main>
    <Cover lang={lang} entries={entries} />
    {cases.map((project, i) => <CaseChapter lang={lang} project={project} page={folio(i)} />)}
    <PathChapter lang={lang} page={pages.path} />
    <HowChapter lang={lang} page={pages.how} />
    <ArchiveChapter lang={lang} page={pages.archive} />
  </main>
</Layout>
