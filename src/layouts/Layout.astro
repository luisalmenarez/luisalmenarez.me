---
import '@fontsource-variable/noto-serif-display/wght.css';
import '@fontsource-variable/noto-serif-display/wght-italic.css';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource/pixelify-sans/400.css';
import '@/styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { useTranslations, getLocalizedPath, locales, defaultLocale } from '@/i18n';
import { buildPersonSchema } from '@/data/profile';
import type { Locale } from '@/i18n';

interface Props {
  title: string;
  lang: Locale;
  description?: string;
  ogImage?: string;
  /** Intrinsic size of `ogImage`. Omit it and the size tags are left out. */
  ogImageSize?: { width: number; height: number };
  /** Describes `ogImage`. Defaults to the site-wide alt text. */
  ogImageAlt?: string;
  /** Structured data for this page. Defaults to the site-wide Person. */
  schema?: object;
  /**
   * Keep this page out of the index. The not-found page needs it: it is served
   * with a 404 for missing routes, where the status already tells crawlers to
   * drop the URL — but it is also reachable at its own address (/404.html,
   * /en/404/), where it answers 200 with "this page does not exist". That is a
   * soft 404, and the canonical and hreflang tags below actively advertise it
   * as a real, translated page.
   */
  noindex?: boolean;
  /** Close the page with the full contact chapter (the home does). */
  withContact?: boolean;
}

const {
  title,
  lang,
  description,
  ogImage,
  ogImageSize,
  ogImageAlt,
  schema,
  noindex,
  withContact,
} = Astro.props;
const t = useTranslations(lang);

const metaDescription = description ?? t('meta.description');
// The branded share card for this locale, served from public/ at a URL that
// never changes. An astro:assets path carries a content hash, so editing the
// image would mint a new URL while the platforms keep serving the cached old
// one under the address already shared.
const ogImageUrl =
  ogImage ?? new URL(`/og-${lang}.png`, Astro.site).toString();
const ogSize = ogImage ? ogImageSize : { width: 1200, height: 630 };
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogLocale = lang === 'es' ? 'es_CO' : 'en_US';
const ogAlt = ogImageAlt ?? t('meta.ogAlt');

const localizedUrl = (locale: Locale) =>
  new URL(getLocalizedPath(Astro.url.pathname, locale), Astro.site).toString();
const structuredData =
  schema ?? buildPersonSchema({ lang, description: metaDescription });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    {
      locales.map((locale) => (
        <link rel="alternate" hreflang={locale} href={localizedUrl(locale)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={localizedUrl(defaultLocale)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Matches the page background rather than the brand accent, so the browser
    chrome blends into the page instead of framing it. The site has one dark
    theme, so one value covers every OS preference. */}
    <meta name="theme-color" content="#111110" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Luis Almenarez" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImageUrl} />
    {
      ogSize && (
        <>
          <meta property="og:image:width" content={String(ogSize.width)} />
          <meta property="og:image:height" content={String(ogSize.height)} />
        </>
      )
    }
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta
      property="og:locale:alternate"
      content={lang === defaultLocale ? 'en_US' : 'es_CO'}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <title>{title}</title>

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>
  </head>
  <body>
    <SiteHeader lang={lang} />
    <slot />
    <SiteFooter lang={lang} withContact={withContact} />
    <script>
      // Reveal marked blocks once, as they enter the viewport.
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          }),
        { rootMargin: '0px 0px -12% 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
