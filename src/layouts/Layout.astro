---
import '@fontsource-variable/onest';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Aside from '@/components/Aside.astro';
import { useTranslations, getLocalizedPath, locales, defaultLocale } from '@/i18n';
import { PROFILE, buildPersonSchema } from '@/data/profile';
import type { Locale } from '@/i18n';

interface Props {
  title: string;
  lang: Locale;
  description?: string;
  ogImage?: string;
  /** Structured data for this page. Defaults to the site-wide Person. */
  schema?: object;
}

const { title, lang, description, ogImage, schema } = Astro.props;
const t = useTranslations(lang);

const metaDescription = description ?? t('meta.description');
const ogImageUrl = ogImage ?? PROFILE.avatar;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogLocale = lang === 'es' ? 'es_CO' : 'en_US';
const ogAlt = t('meta.ogAlt');

const localizedUrl = (locale: Locale) =>
  new URL(getLocalizedPath(Astro.url.pathname, locale), Astro.site).toString();
const structuredData =
  schema ?? buildPersonSchema({ lang, description: metaDescription });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {
      locales.map((locale) => (
        <link rel="alternate" hreflang={locale} href={localizedUrl(locale)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={localizedUrl(defaultLocale)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Luis Almenarez" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta
      property="og:locale:alternate"
      content={lang === defaultLocale ? 'en_US' : 'es_CO'}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <title>{title}</title>

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        if (
          stored === 'dark' ||
          (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>
  </head>
  <body
    class="print:block print:p-8 print:max-w-none print:bg-white print:text-black relative flex flex-col items-center max-w-7xl mx-auto sm:px-12 px-4 sm:py-20 py-14 bg-white dark:bg-[#0a0a0f] text-gray-900 dark:text-gray-100"
  >
    <div
      class="print:hidden bg-[#ede8ff]/60 dark:bg-[#1d1f31] absolute top-[-6rem] -z-10 right-[11rem] h-[20rem] w-[20rem] rounded-full blur-[5rem] sm:w-[40rem] will-change-transform"
    >
    </div>
    <div
      class="print:hidden bg-[#e4e8ff]/50 dark:bg-[#181c26] absolute top-[-1rem] -z-10 left-[-20rem] h-[20rem] w-[30rem] rounded-full blur-[5rem] sm:w-[40rem] md:left-[-18rem] lg:left-[-14rem] xl:left-[-8rem] 2xl:left-[-3rem] will-change-transform"
    >
    </div>
    <Header lang={lang} />
    <div
      class="print:block flex flex-col xl:flex-row justify-center items-start w-full gap-x-14"
    >
      <Aside lang={lang} />
      <slot />
    </div>
    <Footer lang={lang} />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
  }

  .dark {
    color-scheme: dark;
  }

  html {
    font-family: 'Onest variable', system-ui, sans-serif;
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
