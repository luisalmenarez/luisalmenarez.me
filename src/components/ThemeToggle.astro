---
import { getLangFromUrl, useTranslations } from '@/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

{/*
  Named for what it controls, with aria-pressed carrying the state, so a screen
  reader announces "Dark mode, button, not pressed" — what this is and where it
  currently stands. Labelling the action instead ("switch to dark mode") would
  name the outcome but leave the state to be inferred, and aria-pressed is the
  pattern the project filters already use.

  The pressed state reflects the resolved appearance, not a stored choice: a
  reader who never picked a theme and inherits dark from the OS sees it pressed,
  which is true of what is on screen.
*/}
<div>
  <button
    id="theme-toggle"
    class="flex items-center justify-center p-1.5 md:p-2 rounded-full transition-colors hover:text-indigo-500 dark:hover:text-indigo-400 cursor-pointer"
    aria-label={t('a11y.darkMode')}
    aria-pressed="false"
  >
    <!-- Sun icon (visible in dark mode) -->
    <svg
      id="icon-sun"
      class="hidden dark:block"
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>

    <!-- Moon icon (visible in light mode) -->
    <svg
      id="icon-moon"
      class="block dark:hidden"
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </button>
</div>

<script>
  // Icon visibility is resolved by CSS from .dark on <html>, which the inline
  // script in <head> applies before first paint.

  /**
   * Layout ships two <meta name="theme-color"> tags scoped by
   * prefers-color-scheme. That follows the OS without any JavaScript, but it
   * cannot follow a stored theme that contradicts it: force dark on a light OS
   * and the browser chrome stays white against a dark page.
   *
   * The palette is read back off those tags instead of being restated here —
   * the values belong to the layout, and copying them is how the two drift
   * apart.
   */
  const themeColorMetas = document.querySelectorAll<HTMLMetaElement>(
    'meta[name="theme-color"]'
  );

  const palette = new Map<string, string>();

  themeColorMetas.forEach((meta) => {
    const scheme = (meta.getAttribute('media') ?? '').includes('dark')
      ? 'dark'
      : 'light';
    const content = meta.getAttribute('content');
    if (content && !palette.has(scheme)) palette.set(scheme, content);
  });

  /**
   * Writes the resolved colour to BOTH tags, so whichever media query the
   * browser matches already holds the right value. Nothing is added or removed,
   * so the markup still stands on its own if this script never runs.
   */
  function syncThemeColor(isDark: boolean) {
    const colour = palette.get(isDark ? 'dark' : 'light');
    if (!colour) return;

    themeColorMetas.forEach((meta) => meta.setAttribute('content', colour));
  }

  const button = document.getElementById('theme-toggle');

  /**
   * The markup ships aria-pressed="false" because the server cannot know the
   * theme: it comes from localStorage or the OS. The inline script in <head>
   * has already resolved it onto <html> by the time this runs, so the button
   * is corrected before anyone can reach it.
   */
  function syncPressed(isDark: boolean) {
    button?.setAttribute('aria-pressed', String(isDark));
  }

  const startsDark = document.documentElement.classList.contains('dark');
  syncThemeColor(startsDark);
  syncPressed(startsDark);

  button?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    syncThemeColor(isDark);
    syncPressed(isDark);
  });
</script>
