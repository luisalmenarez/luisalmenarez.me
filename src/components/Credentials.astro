---
import { CREDENTIALS } from '@/data/credentials';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { education, certifications, languages } = CREDENTIALS[lang];
---

<div class="md:grid-cols-3 grid grid-cols-1 gap-8">
  <section class="flex flex-col gap-4">
    <h3
      class="text-zinc-700 dark:text-zinc-200 text-xs font-semibold tracking-widest uppercase"
    >
      {t('credentials.education')}
    </h3>
    <ul class="flex flex-col gap-4">
      {
        education.map((entry) => (
          <li class="flex flex-col gap-0.5">
            <p class="text-zinc-900 dark:text-zinc-100 text-sm font-medium leading-tight">
              {entry.title}
            </p>
            <p class="text-zinc-600 dark:text-zinc-400 text-xs">
              {entry.institution}
            </p>
            <p class="text-zinc-600 dark:text-zinc-400 text-xs italic">
              {entry.period}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="flex flex-col gap-4">
    <h3
      class="text-zinc-700 dark:text-zinc-200 text-xs font-semibold tracking-widest uppercase"
    >
      {t('credentials.certifications')}
    </h3>
    <ul class="flex flex-col gap-2">
      {
        certifications.map((cert) => (
          <li class="flex items-start gap-2">
            <div class="bg-indigo-500 dark:bg-indigo-400 w-1.5 h-1.5 mt-2 rounded-full flex-shrink-0" />
            <span class="text-zinc-700 dark:text-zinc-300 text-sm leading-snug">
              {cert.name}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="flex flex-col gap-4">
    <h3
      class="text-zinc-700 dark:text-zinc-200 text-xs font-semibold tracking-widest uppercase"
    >
      {t('credentials.languages')}
    </h3>
    <ul class="flex flex-col gap-2">
      {
        languages.map((language) => (
          <li class="flex items-center justify-between gap-2">
            <span class="text-zinc-800 dark:text-zinc-200 text-sm font-medium">
              {language.name}
            </span>
            <span class="text-zinc-500 dark:text-zinc-400 text-xs italic">
              {language.level}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</div>
