---
interface Props {
  class?: string;
  id?: string;
  as?: keyof HTMLElementTagNameMap;
  [key: string]: unknown;
}

const { class: className, id, as: Tag = 'section', ...rest } = Astro.props;
---

<Tag id={id} class={`w-full lg:w-[740px] mx-auto ${className ?? ''}`} {...rest}>
  <slot />
</Tag>
