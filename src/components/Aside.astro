---
import { Image } from 'astro:assets';
import SectionContainer from '@/components/SectionContainer.astro';
import Badge from '@/components/Badge.astro';
import LinkedInIcon from '@/components/icons/LinkedIn.astro';
import GitHubIcon from '@/components/icons/GitHub.astro';
import MailIcon from '@/components/icons/Mail.astro';
import DownloadIcon from '@/components/icons/Download.astro';
import SocialPill from '@/components/SocialPill.astro';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import avatar from '@/assets/avatar.jpg';
import { PROFILE } from '@/data/profile';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<SectionContainer
  as="aside"
  aria-label={t('a11y.profile')}
  class="pb-20 xl:pb-4"
>
  <Image
    src={avatar}
    alt={PROFILE.name}
    class="size-32 mb-4 rounded-xl"
    width={128}
    height={128}
    densities={[1, 2]}
    loading="eager"
    fetchpriority="high"
  />

  <h1
    class="gap-2 text-pretty sm:text-4xl flex flex-col items-start pb-4 text-xl font-bold text-gray-900 dark:text-gray-100"
  >
    {PROFILE.name}
    <a
      href={PROFILE.social.linkedin}
      target="_blank"
      rel="noreferrer"
      class="flex items-center justify-center"
    >
      <Badge>
        {t('aside.badge')}
        <span slot="hover-text">{t('aside.badge')}</span>
      </Badge>
    </a>
  </h1>
  <h2 class="opacity-80 text-wrap text-base">
    {t('aside.description')}
  </h2>
  <nav
    class="print:hidden flex flex-wrap gap-1 mt-4"
    aria-label={t('a11y.socialNav')}
  >
    <SocialPill
      href={PROFILE.social.linkedin}
      label={t('social.linkedin')}
    >
      <LinkedInIcon class="size-4 md:size-6" />
    </SocialPill>

    <SocialPill
      href={PROFILE.social.github}
      label={t('social.github')}
    >
      <GitHubIcon class="size-4 md:size-6" />
    </SocialPill>

    <SocialPill
      href={`mailto:${PROFILE.email}`}
      label={t('social.email')}
    >
      <MailIcon class="size-4 md:size-6" />
    </SocialPill>

    <SocialPill
      href={PROFILE.social.whatsapp}
      label={t('social.whatsapp')}
    >
      <WhatsAppIcon class="size-4 md:size-6" />
    </SocialPill>
  </nav>

  <button
    type="button"
    data-download-cv
    class="bg-indigo-700 hover:bg-indigo-500 dark:bg-indigo-700 dark:hover:bg-indigo-500 text-white print:hidden inline-flex items-center gap-2 px-4 py-2 mt-4 text-sm font-medium transition-colors rounded-full cursor-pointer"
  >
    <DownloadIcon class="size-4" />
    {t('aside.downloadCV')}
  </button>
</SectionContainer>

<script>
  document.querySelectorAll('[data-download-cv]').forEach((btn) => {
    btn.addEventListener('click', () => window.print());
  });
</script>
