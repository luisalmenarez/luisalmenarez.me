---
import { Image } from 'astro:assets';
import FolderIcon from '@/components/icons/FolderIcon.astro';
import ArrowOutward from '@/components/icons/ArrowOutward.astro';
import ArrowDown from '@/components/icons/ArrowDown.astro';
import GitHub from '@/components/icons/GitHub.astro';
import ExternalLink from '@/components/icons/ExternalLink.astro';
import {
  PROJECTS,
  type ProjectKind,
  type ProjectRole,
  type ProjectStatus,
} from '@/data/projects';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const ROLE_LABEL = {
  developed: 'projects.role.developed',
  contributed: 'projects.role.contributed',
  team: 'projects.role.team',
} as const satisfies Record<ProjectRole, string>;

const ROLE_CLASS: Record<ProjectRole, string> = {
  developed:
    'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/30',
  contributed:
    'bg-blue-500/10 text-blue-700 dark:text-blue-400 border-blue-500/30',
  team: 'bg-zinc-500/10 text-zinc-700 dark:text-zinc-300 border-zinc-500/30',
};

const STATUS_LABEL = {
  archived: 'projects.status.archived',
  wip: 'projects.status.wip',
} as const satisfies Partial<Record<ProjectStatus, string>>;

const STATUS_CLASS: Record<keyof typeof STATUS_LABEL, string> = {
  archived:
    'bg-zinc-500/10 text-zinc-600 dark:text-zinc-400 border-zinc-500/30',
  wip: 'bg-amber-500/10 text-amber-700 dark:text-amber-400 border-amber-500/30',
};

const projects = [...PROJECTS].sort(
  (a, b) => Number(!!b.featured) - Number(!!a.featured)
);

// ── Filters ──────────────────────────────────────────────────────────────────
// Build dynamically so filters with 0 matches do not render.
type FilterScope = 'all' | 'kind' | 'role';
interface FilterEntry {
  id: string;
  label: string;
  count: number;
  scope: FilterScope;
  value?: string;
}

const KIND_FILTERS = [
  { value: 'professional', key: 'projects.filter.professional' },
  { value: 'personal', key: 'projects.filter.personal' },
  { value: 'oss', key: 'projects.filter.oss' },
] as const satisfies readonly { value: ProjectKind; key: string }[];

const ROLE_FILTERS = [
  { value: 'contributed', key: 'projects.filter.contributed' },
  { value: 'team', key: 'projects.filter.team' },
] as const satisfies readonly { value: ProjectRole; key: string }[];

const filters: FilterEntry[] = [
  {
    id: 'all',
    label: t('projects.filter.all'),
    count: projects.length,
    scope: 'all',
  },
];

for (const f of KIND_FILTERS) {
  const count = projects.filter((p) => p.kind === f.value).length;
  if (count > 0) {
    filters.push({
      id: `kind-${f.value}`,
      label: t(f.key),
      count,
      scope: 'kind',
      value: f.value,
    });
  }
}

for (const f of ROLE_FILTERS) {
  const count = projects.filter((p) => p.role === f.value).length;
  if (count > 0) {
    filters.push({
      id: `role-${f.value}`,
      label: t(f.key),
      count,
      scope: 'role',
      value: f.value,
    });
  }
}

const showFilters = filters.length > 1;
---

{
  showFilters && (
    <div
      class="print:hidden flex flex-wrap items-center gap-2 mb-6"
      role="toolbar"
      aria-label={t('a11y.projectFilters')}
    >
      {filters.map((filter, index) => (
        <button
          type="button"
          data-filter
          data-filter-scope={filter.scope}
          data-filter-value={filter.value ?? ''}
          data-active={index === 0 ? 'true' : 'false'}
          class="text-zinc-600 dark:text-zinc-400 bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 data-[active=true]:bg-zinc-900 data-[active=true]:text-white dark:data-[active=true]:bg-zinc-100 dark:data-[active=true]:text-zinc-900 cursor-pointer transition-colors duration-200 rounded-full px-3 py-1 text-xs font-medium"
        >
          {filter.label}
          <span class="ml-1">({filter.count})</span>
        </button>
      ))}
    </div>
  )
}

<div class="md:grid-cols-2 print:flex print:flex-col grid grid-cols-1 gap-6">
  {
    projects.map((project) => {
      const title = project.title[lang];
      const description = project.description[lang];
      const highlights = project.highlights[lang];
      const statusKey =
        project.status in STATUS_LABEL
          ? (project.status as keyof typeof STATUS_LABEL)
          : null;
      const companyDescription = project.company?.description?.[lang];

      return (
        <article
          class="bg-white dark:bg-zinc-900 border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-700 relative flex flex-col p-6 transition-colors duration-200 border rounded-lg shadow-lg"
          data-project
          data-kind={project.kind ?? ''}
          data-role={project.role}
        >
          {project.image && (
            <Image
              src={project.image}
              alt={title}
              class="aspect-video object-cover w-full mb-4 border rounded-md border-zinc-200 dark:border-zinc-800 print:hidden"
              loading="lazy"
              widths={[480, 720, 960]}
              sizes="(min-width: 768px) 360px, 100vw"
            />
          )}
          <div class="flex flex-wrap items-start justify-between gap-2 mb-3">
            {project.link ? (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="group/more text-indigo-600 dark:text-indigo-400 flex items-center gap-2 p-1 rounded"
              >
                <FolderIcon class="size-5 text-zinc-500 dark:text-zinc-400" />
                <h3 class="text-base font-semibold leading-tight">{title}</h3>
                <span class="group-hover/more:translate-x-0.5 group-hover/more:-translate-y-0.5 duration-200 ease-out">
                  <ArrowOutward class="size-5" />
                </span>
              </a>
            ) : (
              <div class="flex items-center gap-2 p-1">
                <FolderIcon class="size-5 text-zinc-500 dark:text-zinc-400" />
                <h3 class="text-base font-semibold leading-tight">{title}</h3>
              </div>
            )}
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-zinc-500 dark:text-zinc-400 text-xs">
                {project.period[lang]}
              </span>
              <span
                class={`inline-flex items-center rounded-full border text-[11px] py-0.5 px-2 ${ROLE_CLASS[project.role]}`}
              >
                {t(ROLE_LABEL[project.role])}
              </span>
              {statusKey && (
                <span
                  class={`inline-flex items-center rounded-full border text-[11px] py-0.5 px-2 ${STATUS_CLASS[statusKey]}`}
                >
                  {t(STATUS_LABEL[statusKey])}
                </span>
              )}
            </div>
          </div>
          {project.company && (
            <p class="text-zinc-600 dark:text-zinc-400 mb-3 -mt-1 text-xs">
              <span>@ </span>
              {project.company.url ? (
                <a
                  href={project.company.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-black dark:hover:text-white underline underline-offset-2 transition-colors"
                >
                  {project.company.name}
                </a>
              ) : (
                <span>{project.company.name}</span>
              )}
              {companyDescription && (
                <span> · {companyDescription}</span>
              )}
            </p>
          )}
          <p class="text-zinc-700 dark:text-zinc-300 mb-4 text-sm">
            {description}
          </p>

          <details class="proj-details group/details mb-4">
            <summary class="group/more w-fit cursor-pointer items-center justify-center gap-1.5 text-xs underline text-zinc-500 dark:text-zinc-400 transition-colors duration-300 hover:text-black dark:hover:text-white flex list-none [&::-webkit-details-marker]:hidden">
              <span class="proj-toggle-text text-zinc-500 dark:text-zinc-400 text-sm italic underline">
                {t('projects.showMore')}
              </span>
              <ArrowDown class="text-zinc-500 dark:text-zinc-400 size-4 transition-transform duration-300 group-open/details:rotate-180" />
            </summary>
            <div class="flex flex-col gap-4 mt-4 animate-fade-in">
              <h4 class="text-lg font-semibold">{t('projects.features')}</h4>
              <ul class="text-zinc-700 dark:text-zinc-300 space-y-2 text-sm">
                {highlights.map((highlight) => (
                  <li class="flex items-start gap-2">
                    <div class="w-1.5 h-1.5 rounded-full bg-zinc-400 dark:bg-zinc-500 flex-shrink-0 mt-2" />
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>
          </details>

          <div class="flex flex-wrap gap-2 mb-4">
            {project.tags.map((tag) => (
              <span
                class={`inline-flex items-center gap-1.5 rounded-full text-xs py-1 px-2.5 ${tag.class}`}
              >
                <tag.icon class="size-3" />
                {tag.name}
              </span>
            ))}
          </div>
          <div class="border-zinc-200 dark:border-zinc-800 flex gap-6 pt-4 mt-auto border-t">
            {project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-zinc-500 dark:text-zinc-400 hover:text-black dark:hover:text-white inline-flex items-center gap-2 text-sm transition-colors"
              >
                <GitHub class="size-5" />
                {t('projects.viewGithub')}
              </a>
            )}
            {project.link && (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="text-zinc-500 dark:text-zinc-400 hover:text-black dark:hover:text-white inline-flex items-center gap-2 text-sm transition-colors"
              >
                <ExternalLink class="size-5" />
                {t('projects.visitSite')}
              </a>
            )}
          </div>
        </article>
      );
    })
  }
</div>

<script>
  document.querySelectorAll('.proj-details').forEach((details) => {
    const toggleText = details.querySelector('.proj-toggle-text');
    if (!toggleText) return;
    const showMore = toggleText.textContent?.trim() || '';
    const showLess = showMore === 'Mostrar más' ? 'Mostrar menos' : 'Show less';

    details.addEventListener('toggle', () => {
      toggleText.textContent = (details as HTMLDetailsElement).open
        ? showLess
        : showMore;
    });
  });

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-project]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const scope = btn.dataset.filterScope;
      const value = btn.dataset.filterValue ?? '';

      buttons.forEach((b) => (b.dataset.active = 'false'));
      btn.dataset.active = 'true';

      cards.forEach((card) => {
        const matches =
          scope === 'all' ||
          (scope === 'kind' && card.dataset.kind === value) ||
          (scope === 'role' && card.dataset.role === value);
        card.style.display = matches ? '' : 'none';
      });
    });
  });
</script>
