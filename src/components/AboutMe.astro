---
import { Image } from 'astro:assets';
import avatar from '@/assets/avatar.jpg';
import { PROFILE } from '@/data/profile';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="flex gap-x-8 md:flex-row flex-col-reverse">
  <div
    class="flex flex-col [&>p]:mb-4 [&>p>strong]:text-indigo-600 dark:[&>p>strong]:text-indigo-400 text-pretty"
  >
    <p set:html={t('about.p1')} />
    <p set:html={t('about.p2')} />
    <p set:html={t('about.p3')} />
  </div>
  <Image
    src={avatar}
    alt={PROFILE.name}
    class="size-36 rounded-full mb-8 md:mb-0"
    width={144}
    height={144}
    densities={[1, 2]}
    loading="lazy"
  />
</section>
